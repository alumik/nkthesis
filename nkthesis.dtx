% \subsection{公式}
%
% \changes{v2.3}{2025/12/27}{使用 \pkg{mathtools} 自定义公式标签格式，不再手动复写底层命令，提高代码鲁棒性。}
%
% 设置公式标签格式。
%
%    \begin{macrocode}
\newtagform { @@ }
    { \mslinespread { 1 } \songti \zihao { 5 } （ }
    { ） }
\usetagform { @@ }
%    \end{macrocode}
%
% \changes{v2026.4}{2026/03/28}{使公式上下间距保持一致。}
%
% 减小公式行距。
%
% \begin{macro}{\@@_display_spacing_begin:}
%
% \changes{v2026.7}{2026/08/13}{使用 \LaTeXiii{} 接口重写，不再混用 \TeX{} 内部量。}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_display_spacing_begin:
    {
        \begin { singlespace }
        \skip_vertical:n { -1.2\baselineskip }
        \noindent
        \dim_set:Nn \l_@@_temp_dim { \tex_hsize:D + 1pt }
        \skip_horizontal:n { \l_@@_temp_dim minus 2pt }
        \null
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_display_spacing_end:}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_display_spacing_end:
    {
        \end { singlespace }
        \noindent
        \ignorespaces
    }
%    \end{macrocode}
% \end{macro}
%
% 将上述间距调整应用于所有显示型公式环境。
%
% \changes{v2026.7}{2026/08/13}{改用 \cs{AddToHook} 并为钩子加上标签，同时用循环生成，避免重复代码。}
%
%    \begin{macrocode}
\clist_map_inline:nn
    { equation, equation*, align, align*, gather, gather* }
    {
        \AddToHook { env / #1 / before } [ nkthesis ]
            { \@@_display_spacing_begin: }
        \AddToHook { env / #1 / after  } [ nkthesis ]
            { \@@_display_spacing_end:   }
    }
%    \end{macrocode}
