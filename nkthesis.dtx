    {
        paperwidth  .code:n    = \@@_config_set:nn { layout / paperwidth } {#1},
        paperwidth  .initial:n = 210mm,
        paperheight .code:n    = \@@_config_set:nn
            { layout / paperheight } {#1},
        paperheight .initial:n = 297mm,
        left        .code:n    = \@@_config_set:nn { layout / left } {#1},
        left        .initial:n = 32mm,
        right       .code:n    = \@@_config_set:nn { layout / right } {#1},
        right       .initial:n = 32mm,
        top         .code:n    = \@@_config_set:nn { layout / top } {#1},
        top         .initial:n = 30mm,
        textheight  .code:n    = \@@_config_set:nn { layout / textheight } {#1},
        textheight  .initial:n = 221mm,
        headheight  .code:n    = \@@_config_set:nn { layout / headheight } {#1},
        headheight  .initial:n = 14.8bp,
        headsep     .code:n    = \@@_config_set:nn { layout / headsep } {#1},
        headsep     .initial:x = \dim_eval:n { 8mm - 14.8bp },
        footskip    .code:n    = \@@_config_set:nn { layout / footskip } {#1},
        footskip    .initial:n = 8mm,
    }
