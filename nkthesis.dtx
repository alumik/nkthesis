% \begin{macro}{\@@_keys_set:nn, \@@_keys_get:nn}
%
% \changes{v2026.7}{2026/08/13}{修复 \cs{@@_keys_get:nn} 在可展开语境中报错时会残留未展开记号的问题。}
% \changes{v2.3}{2025/12/27}{当键名不存在时直接报错而不是返回空值。}
% \changes{v2026.7}{2026/08/14}{使用已经存在的 \cs{@@_config_get:n} 来读取属性值。}
%
% 键值写入和读取命令。
%
%    \begin{macrocode}
\msg_new:nnn { @@ } { invalid-key }
    { The~key~'#1'~is~not~defined~in~the~nkthesis~class. }
\cs_new_protected:Nn \@@_keys_set:nn
    { \keys_set:nn { @@ / #1 } {#2} }
\cs_new:Nn \@@_keys_get:nn
    {
        \keys_if_exist:nnTF { @@ / #1 } {#2}
            { \@@_config_get:n { #1 / #2 } }
            { \msg_expandable_error:nnn { @@ } { invalid-key } { #1 / #2 } }
    }
%    \end{macrocode}
% \end{macro}
