%
% 加宽页眉横线以匹配 Microsoft Word 样式。
%
%    \begin{macrocode}
\fancyhfoffset { 1.428571pt }
\cs_set:Npn \headrulewidth { 0.7bp }
\fancyhf { }
\fancyhead [ C ]
    {
        \mslinespread { 1 }
        \songti
        \zihao { 5 }
        \bool_if:NTF \l_@@_uppercasehead_bool
            { \leftmark }
            { \nouppercase \leftmark }
