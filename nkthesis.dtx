%
% \changes{v2026.2}{2026/03/14}{抛弃传统字符串处理宏包，使用 \pkg{l3regex} 重构简单引用命令。}
% \changes{v2.4}{2025/12/28}{修复使用 \cs{simpleref} 引用子图和公式时显示为空的问题。}
% \changes{v2026.3}{2026/03/15}{移除原有的 \cs{simpleref} 等命令。}
%
% \begin{macro}{\@@_apply_align:nn}
%
% 表辅助函数：根据指定的对齐方式应用相应的水平对齐命令。
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_apply_align:nn
    {
        \str_case:nnF {#1}
            {
                { c } { \centering #2 }
                { l } { \raggedright #2 }
                { r } { \raggedleft #2 }
                { s } { \makebox [ \linewidth ] [ s ] {#2} }
            }
            {#2}
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_make_cell:nnnnn}
%
% 表辅助函数：统一处理带固定宽度的表格单元格。
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_make_cell:nnnnn
    {
        \makebox [#1] [ c ]
            {
                \tl_if_empty:nTF {#2}
                    {
                        \parbox [ c ]
                            { \dim_eval:n { #1 - #3 - #3 } }
                            {
                                \vspace { 1.4mm }
                                \@@_apply_align:nn {#4} {#5}
                                \vspace { 1.4mm }
                            }
                    }
                    {
                        \parbox [ c ] [#2] [ c ]
                            { \dim_eval:n { #1 - #3 - #3 } }
                            {
                                \vspace { 1.4mm }
                                \@@_apply_align:nn {#4} {#5}
                                \vspace { 1.4mm }
                            }
                    }
            }
    }
%    \end{macrocode}
% \end{macro}
