% \subsection{自定义环境}
%
% \subsubsection{摘要}
%
% \changes{v2.2}{2025/05/23}{让页眉符合 \texttt{uppercasehead} 设置。}
% \changes{v2026.7}{2026/08/14}{让英文摘要选项的大小写不敏感。}
%
% \begin{environment}{abstract}
%
% \changes{v2026.2}{2026/03/14}{合并中英文摘要和关键词环境，通过可选参数 \texttt{[en]} 切换为英文。}
%
%    \begin{macrocode}
\NewDocumentEnvironment { abstract } { O{ } }
    {
        \str_if_eq:eeTF { \str_lowercase:n { #1 } } { en }
            {
