% \changes{v2026.1}{2026/03/12}{调整行间距时不再需要使用 \texttt{\textbackslash selectfont}。}
%
% Microsoft Word 多倍行距模拟。
%
%    \begin{macrocode}
\NewDocumentCommand \mslinespread { m }
    {
        \linespread
            {
                \fp_eval:n
                    {
                        #1 *
                        \@@_keys_get:nn { typesetting } { ms-base-linespread } /
                        1.2
                    }
            }
        \selectfont
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mslinespreadbp}
%
% Microsoft Word 固定行距模拟。
%
%    \begin{macrocode}
\NewDocumentCommand \mslinespreadbp { m m }
    {
        \linespread { \fp_eval:n { #1 / #2 / 1.2 } }
        \selectfont
    }
%    \end{macrocode}
% \end{macro}
%
% \subsection{文档结构}
%
% \changes{v2.4}{2026/01/06}{使用大写字母作为封面页和声明页的页码编号，避免正文中产生重复页码对象。}
% \changes{v2026.7}{2026/08/13}{通过 \pkg{hyperref} 的 \texttt{hypertexnames=false} 消除重复页码对象，封面页码不再需要使用 \texttt{Alph} 编号。}
%
% 封面页和声明页的页码需要与正文分开，否则 \pkg{hyperref} 会产生重复的页码对象。
% \pkg{hyperref} 默认以 \cs{thepage} 的值命名页面锚点（\texttt{page.\meta{页码}}），
% 因此封面材料与正文一旦出现相同的页码值就会冲突。
% 载入 \pkg{hyperref} 时设置 \texttt{hypertexnames=false}，
% 页面锚点改为按物理页递增的计数器命名，消除了冲突，封面页码的编号形式因此可以自由选择。
%
% 这里使用小写罗马数字。
% 早期版本使用 \texttt{Alph} 编号来回避冲突，但 \texttt{Alph} 最多只能表示 26 页，
% 超出后 \LaTeX{} 会报错。
%
%    \begin{macrocode}
\AddToHook { begindocument } [ nkthesis ] { \pagenumbering { roman } }
%    \end{macrocode}
%
% \begin{macro}{\frontmatter}
%
% \changes{v2.2}{2025/05/23}{将前置部分的页面风格设置为 \texttt{fancy}。}
% \changes{v2026.7}{2026/08/13}{去掉重置页码的冗余代码，\cs{pagenumbering} 内部已经完成该操作。}
%
%    \begin{macrocode}
\RenewDocumentCommand \frontmatter { }
    {
        \bool_if:NTF \l_@@_openright_bool
            { \cleardoublepage }
            { \clearpage }
        \pagenumbering { Roman }
        \pagestyle { fancy }
        \ctexset
            {
                chapter/format = {
                    \mslinespread { 1 }
                    \heiti
                    \zihao { 3 }
                    \bfseries
                    \centering
                },
            }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro} {\mainmatter}
%    \begin{macrocode}
\RenewDocumentCommand \mainmatter { }
    {
        \bool_if:NTF \l_@@_openright_bool
            { \cleardoublepage }
            { \clearpage }
        \pagenumbering { arabic }
        \pagestyle { fancy }
        \int_compare:nNnT \l_@@_headingmode_int = 1
            {
                \ctexset
                    {
                        chapter/format = {
                            \mslinespread { 1 }
                            \heiti
                            \zihao { 3 }
                            \bfseries
                        },
                    }
            }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\backmatter}
%    \begin{macrocode}
\RenewDocumentCommand \backmatter { }
    {
        \bool_if:NTF \l_@@_openright_bool
            { \cleardoublepage }
            { \clearpage }
        \pagestyle { fancy }
        \ctexset
            {
                chapter/format = {
                    \mslinespread { 1 }
                    \heiti
                    \zihao { 3 }
                    \bfseries
                    \centering
                },
            }
    }
%    \end{macrocode}
% \end{macro}
