        listtablename  = 附表清单,
        chapter = {
            fixskip    = true,
            beforeskip = 24bp,
            afterskip  = 26bp,
            aftername  = \hspace { \ccwd },
            pagestyle  = fancy,
            tocline    = {
                \CTEXifname
                    {
                        \protect
                            {
                                \csname CTEXthe#1 \endcsname
                                \hspace { \ccwd }
                            }
                    }
                    { }
                #2
            },
        },
        section = {
            fixskip    = true,
            beforeskip = 32bp,
            afterskip  = 14bp,
            aftername  = \hspace { \ccwd },
            tocline    = {
                \CTEXifname
                    {
                        \protect
                            {
                                \csname CTEXthe#1 \endcsname
                                \hspace { \ccwd }
                            }
                    }
                    { }
                #2
            },
        },
        subsection = {
            fixskip    = true,
            format     = {
                \mslinespread { 1 }
                \heiti
                \fontsize { 13bp } { 15.6bp }
                \selectfont
            },
            beforeskip = 20bp,
            afterskip  = 14bp,
        },
        subsubsection = {
            fixskip    = true,
            format     = \mslinespread { 1 } \heiti \zihao { -4 },
            beforeskip = 20bp,
            afterskip  = 14bp,
        },
    }
