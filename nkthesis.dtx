% \begin{macro}{\@@_suppress_overfull:}
%
% \changes{v2026.7}{2026/08/13}{将抑制溢出警告的重复代码抽取为独立命令。}
%
% 抑制当前分组内的行溢出警告。
% 部分表格的宽度会超过版心，但这是还原模版所必需的，因此屏蔽相应警告。
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_suppress_overfull:
    {
        \dim_set:Nn \tex_hfuzz:D    { \c_max_dim }
        \int_set:Nn \tex_hbadness:D { 99999      }
    }
