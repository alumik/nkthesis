% \subsubsection{论文基本信息}
%
% \begin{variable}{\c_@@_thesis_type_prop}
%
% \changes{v2026.7}{2026/08/13}{将《匿名评阅封面》的论文类别名称集中定义，避免与键值选项列表各自维护而产生偏差。}
%
% 论文类别到《匿名评阅封面》标题文字的映射。
% 该属性列表同时用于生成 \texttt{题名页/论文类别} 的可选值，
% 因此选项列表与显示文字只有这一处定义，不会出现两边不同步的问题。
%
%    \begin{macrocode}
\prop_const_from_keyval:Nn \c_@@_thesis_type_prop
    {
        硕士     = 硕士毕业（学位）论文,
        博士     = 博士毕业（学位）论文,
        硕士专业 = 硕士学位论文/实践成果报告,
        博士专业 = 博士学位论文/实践成果报告,
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}{\g_@@_thesis_type_clist}
%
% 由上述映射的键生成的论文类别可选值列表，供 \texttt{.choices:Vn} 使用。
%
%    \begin{macrocode}
\clist_new:N \g_@@_thesis_type_clist
\prop_map_inline:Nn \c_@@_thesis_type_prop
    { \clist_gput_right:Nn \g_@@_thesis_type_clist {#1} }
%    \end{macrocode}
% \end{variable}
%
% \changes{v2.1}{2025/05/09}{去掉论文题目的默认值。}
% \changes{v2.2}{2025/05/29}{调整论文完成时间的默认值。}
% \changes{v2.2}{2025/05/29}{加粗答辩日期。}
% \changes{v2026.0}{2026/03/03}{去掉论文副标题。}
% \changes{v2026.4}{2026/03/23}{将论文基本信息设置中的“一级学科”改为“一级学科或专业学位类别”。}
% \changes{v2026.4}{2026/03/23}{将论文基本信息设置中的“二级学科”改为“二级学科或专业领域”。}
% \changes{v2026.7}{2026/08/13}{用循环生成纯文本键的定义，避免大量重复样板代码。}
%
% 绝大多数论文信息键的行为完全相同：把用户输入原样存入属性列表。
% 因此这里先用一个键名列表批量生成，随后再单独补充默认值和特殊键。
%
%    \begin{macrocode}
\clist_map_inline:nn
    {
        中图分类号,
        学校代码,
        UDC,
        题名页/密级,
        题名页/论文题目字号,
        论文题目（中文）,
        论文题目（英文）,
        论文作者,
        指导教师,
        指导教师职称,
        申请学位,
        培养单位,
        一级学科或专业学位类别,
        二级学科或专业领域,
        研究方向,
        答辩委员会主席,
        评阅人,
        论文完成时间,
        论文编号,
        非公开论文/保密期限/起始日期,
        非公开论文/保密期限/结束日期,
        非公开论文/审批表编号,
        非公开论文/批准日期,
        原创性声明/电子签名路径,
        原创性声明/电子签名宽度,
        原创性声明/签字日期,
        授权书/电子签名路径,
        授权书/电子签名宽度,
        授权书/签字日期,
        学号,
        答辩日期,
        联系电话,
        电子邮箱,
        通讯地址,
        作者信息/备注,
    }
    {
        \keys_define:nn { @@ / info }
            { #1 .code:n = \@@_config_set:nn { info / #1 } {##1} }
    }
%    \end{macrocode}
%
% 补充上述键的默认值，以及需要限定取值范围的键。
%
%    \begin{macrocode}
\keys_define:nn { @@ / info }
    {
        学校代码                     .initial:n  = 10055,
        题名页/密级                  .initial:n  = 公开,
        题名页/论文题目字号          .initial:n  = 2,
        论文完成时间                 .initial:n  = \qquad 年 \qquad 月,
        非公开论文/保密期限/起始日期 .initial:n  =
            { 20 \qquad 年 \qquad 月 \qquad 日 },
        非公开论文/保密期限/结束日期 .initial:n  =
            { 20 \qquad 年 \qquad 月 \qquad 日 },
        非公开论文/批准日期          .initial:n  =
            { 20 \qquad 年 \qquad 月 \qquad 日 },
        原创性声明/电子签名宽度      .initial:n  = 7em,
        原创性声明/签字日期          .initial:n  = 年 \qquad 月 \qquad 日,
        授权书/电子签名宽度          .initial:n  = 7em,
        授权书/签字日期              .initial:n  =
            { 20 \qquad 年 \qquad 月 \qquad 日 },
        答辩日期                     .initial:n  =
            { \textbf { 20 \qquad 年 \qquad 月 \qquad 日 } },
        题名页/论文类别              .choices:Vn =
            \g_@@_thesis_type_clist
            { \@@_config_set:nn { info / 题名页 / 论文类别 } {#1} },
        题名页/论文类别              .initial:n  = 硕士,
        作者信息/论文类别            .choices:nn =
            { 学术博士, 专业学位博士, 学术硕士, 专业学位硕士, 同等学力硕士 }
            { \@@_config_set:nn { info / 作者信息 / 论文类别 } {#1} },
        作者信息/论文类别            .initial:n  = 学术硕士,
        非公开论文/申请密级          .choices:nn =
            { 公开, 限制, 秘密, 机密 }
            { \@@_config_set:nn { info / 非公开论文 / 申请密级 } {#1} },
        非公开论文/申请密级          .initial:n  = 公开,
    }
