\cs_new_protected:Nn \@@_checked_checkbox:
    {
        \makebox [ 0pt ] [ l ] { \ensuremath { \square } }
        \raisebox { 0.15ex } { \hspace { 0.1em } \ensuremath { \checkmark } }
    }
\cs_new_protected:Nn \@@_checkbox:nn
    {
