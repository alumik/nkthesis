%    \begin{macrocode}
\skip_set:Nn \cftbeforechapskip { 2bp }
\cs_set_protected:Npn \cftchapfont { \mslinespread { 1 } \songti \zihao { 4 } }
\cs_set_protected:Npn \cftchappagefont { \cftchapfont }
