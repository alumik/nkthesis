% \begin{macro}{\@@_lang_ptbr_names:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_ptbr_names:
    {
        \cs_set:Npn \prefacename         { Prefácio       }
        \cs_set:Npn \acknowledgmentsname { Agradecimentos }
        \cs_set:Npn \symabbrname
            { Lista~de~símbolos~e~abreviaturas }
        \cs_set:Npn \resumename
            { Currículo~e~produção~acadêmica }
        \cs_set:Npn \anonymousresumename
            { Produção~acadêmica }
        \ctexset
            {
                contentsname   = Sumário,
                figurename     = Figura,
                tablename      = Tabela,
                listfigurename = Lista~de~figuras,
                listtablename  = Lista~de~tabelas,
                appendixname   = Apêndice,
                bibname        = Referências,
            }
        \DeclareCaptionLabelFormat { @@-ptbr     } { ##1~##2 }
        \DeclareCaptionLabelFormat { @@-ptbr-sub } { (##2)   }
        \captionsetup    { labelformat = @@-ptbr     }
        \subcaptionsetup { labelformat = @@-ptbr-sub }
        \newtagform { @@-ptbr }
            { \mslinespread { 1 } \songti \zihao { 5 } ( }
            { ) }
        \usetagform { @@-ptbr }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_ptbr_mode_two:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_ptbr_mode_two:
    {
        \ctexset
            {
                chapter = {
                    name      = { Capítulo\ , },
                    number    = \arabic { chapter },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 3 }
                        \bfseries
                        \centering
                    },
                },
                section = {
                    name      = { Seção\ , },
                    number    = \arabic { section },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 4 }
                        \bfseries
                        \centering
                    },
                },
                subsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}
                    },
                    aftername = \hspace { \ccwd },
                    tocline   = {
                        \CTEXifname
                            {
                                \protect
                                    {
                                        \csname CTEXthe##1 \endcsname
                                        \hspace { \ccwd }
                                    }
                            }
                            { }
                        ##2
                    },
                },
                subsubsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}.\arabic{subsubsection}
                    },
                    aftername = \hspace { \ccwd },
                },
            }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\c_@@_lang_ptbr_crefname_prop}
%    \begin{macrocode}
\prop_const_from_keyval:Nn \c_@@_lang_ptbr_crefname_prop
    {
        equation      = Eq.,
        figure        = Figura,
        subfigure     = Figura,
        table         = Tabela,
        page          = página,
        chapter       = Capítulo,
        section       = Seção,
        subsection    = Subseção,
        subsubsection = Subsubseção,
        appendix      = Apêndice,
        theorem       = Teorema,
        lemma         = Lema,
        corollary     = Corolário,
        proposition   = Proposição,
        definition    = Definição,
        example       = Exemplo,
        algorithm     = Algoritmo,
        listing       = Listagem,
        line          = linha,
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}{\c_@@_lang_ptbr_cref_counting_clist}
%    \begin{macrocode}
\clist_const:Nn \c_@@_lang_ptbr_cref_counting_clist
    {
        { page          } { página       },
        { chapter       } { Capítulo     },
        { section       } { Seção        },
        { subsection    } { Subseção     },
        { subsubsection } { Subsubseção  },
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_lang_ptbr_cref_set_counting:nn}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_ptbr_cref_set_counting:nn
    {
        \crefformat      {#1} { ##2#2~##1##3                }
        \crefrangeformat {#1} { ##3#2~##1##4~a~##5#2~##2##6 }
        \crefmultiformat {#1}
            { ##2#2~##1##3   } { e~##2#2~##1##3 }
            { ,~##2#2~##1##3 } { e~##2#2~##1##3 }
        \crefrangemultiformat {#1}
            { ##3#2~##1##4~a~##5#2~##2##6   }
            { e~##3#2~##1##4~a~##5#2~##2##6 }
            { ,~##3#2~##1##4~a~##5#2~##2##6 }
            { e~##3#2~##1##4~a~##5#2~##2##6 }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_ptbr_cref:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_ptbr_cref:
    {
        \labelformat { subfigure } { \thefigure~(\thesubfigure) }
        \labelformat { equation  } { (\theequation)             }
        \prop_map_inline:Nn \c_@@_lang_ptbr_crefname_prop
            {
                \crefname {##1} {##2} {##2}
                \Crefname {##1}
                    { \text_titlecase_first:n {##2} }
                    { \text_titlecase_first:n {##2} }
            }
        \clist_map_inline:Nn \c_@@_lang_ptbr_cref_counting_clist
            { \@@_lang_ptbr_cref_set_counting:nn ##1 }
        \crefformat { equation  } { Eq.~##2##1##3  }
        \crefformat { subfigure } { Fig.~##2##1##3 }
        \cs_set:Npn \crefpairconjunction        { ~e~ }
        \cs_set:Npn \crefmiddleconjunction      { ,   }
        \cs_set:Npn \creflastconjunction        { ~e~ }
        \cs_set:Npn \crefpairgroupconjunction   { ~e~ }
        \cs_set:Npn \crefmiddlegroupconjunction { ,   }
        \cs_set:Npn \creflastgroupconjunction   { ~e~ }
        \cs_set:Npn \crefrangeconjunction       { ~a~ }
    }
%    \end{macrocode}
% \end{macro}
