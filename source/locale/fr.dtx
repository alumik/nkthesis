% \begin{macro}{\@@_lang_fr_names:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_fr_names:
    {
        \cs_set:Npn \prefacename         { Avant-propos  }
        \cs_set:Npn \acknowledgmentsname { Remerciements }
        \cs_set:Npn \symabbrname
            { Liste~des~symboles~et~des~abréviations }
        \cs_set:Npn \resumename
            { Curriculum~vitae~et~réalisations~académiques }
        \cs_set:Npn \anonymousresumename
            { Réalisations~académiques }
        \ctexset
            {
                contentsname   = Table~des~matières,
                figurename     = Figure,
                tablename      = Tableau,
                listfigurename = Liste~des~figures,
                listtablename  = Liste~des~tableaux,
                appendixname   = Annexe,
                bibname        = Bibliographie,
            }
        \DeclareCaptionLabelFormat { @@-fr     } { ##1~##2 }
        \DeclareCaptionLabelFormat { @@-fr-sub } { (##2)   }
        \captionsetup    { labelformat = @@-fr     }
        \subcaptionsetup { labelformat = @@-fr-sub }
        \newtagform { @@-fr }
            { \mslinespread { 1 } \songti \zihao { 5 } ( }
            { ) }
        \usetagform { @@-fr }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_fr_mode_two:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_fr_mode_two:
    {
        \ctexset
            {
                chapter = {
                    name      = { Chapitre\ , },
                    number    = \arabic { chapter },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 3 }
                        \bfseries
                        \centering
                    },
                },
                section = {
                    name      = { Section\ , },
                    number    = \arabic { section },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 4 }
                        \bfseries
                        \centering
                    },
                },
                subsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}
                    },
                    aftername = \hspace { \ccwd },
                    tocline   = {
                        \CTEXifname
                            {
                                \protect
                                    {
                                        \csname CTEXthe##1 \endcsname
                                        \hspace { \ccwd }
                                    }
                            }
                            { }
                        ##2
                    },
                },
                subsubsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}.\arabic{subsubsection}
                    },
                    aftername = \hspace { \ccwd },
                },
            }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{variable}{\c_@@_lang_fr_crefname_prop}
%    \begin{macrocode}
\prop_const_from_keyval:Nn \c_@@_lang_fr_crefname_prop
    {
        equation      = éq.,
        figure        = figure,
        subfigure     = figure,
        table         = tableau,
        page          = page,
        chapter       = chapitre,
        section       = section,
        subsection    = sous-section,
        subsubsection = sous-sous-section,
        appendix      = annexe,
        theorem       = théorème,
        lemma         = lemme,
        corollary     = corollaire,
        proposition   = proposition,
        definition    = définition,
        example       = exemple,
        algorithm     = algorithme,
        listing       = listing,
        line          = ligne,
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}{\c_@@_lang_fr_cref_counting_clist}
%    \begin{macrocode}
\clist_const:Nn \c_@@_lang_fr_cref_counting_clist
    {
        { page          } { page              },
        { chapter       } { chapitre          },
        { section       } { section           },
        { subsection    } { sous-section      },
        { subsubsection } { sous-sous-section },
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_lang_fr_cref_set_counting:nn}
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_fr_cref_set_counting:nn
    {
        \crefformat      {#1} { ##2#2~##1##3                }
        \crefrangeformat {#1} { ##3#2~##1##4~à~##5#2~##2##6 }
        \crefmultiformat {#1}
            { ##2#2~##1##3   } { et~##2#2~##1##3 }
            { ,~##2#2~##1##3 } { et~##2#2~##1##3 }
        \crefrangemultiformat {#1}
            { ##3#2~##1##4~à~##5#2~##2##6   }
            { et~##3#2~##1##4~à~##5#2~##2##6 }
            { ,~##3#2~##1##4~à~##5#2~##2##6 }
            { et~##3#2~##1##4~à~##5#2~##2##6 }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_fr_cref:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_fr_cref:
    {
        \labelformat { subfigure } { \thefigure~(\thesubfigure) }
        \labelformat { equation  } { (\theequation)             }
        \prop_map_inline:Nn \c_@@_lang_fr_crefname_prop
            {
                \crefname {##1} {##2} {##2}
                \Crefname {##1}
                    { \text_titlecase_first:n {##2} }
                    { \text_titlecase_first:n {##2} }
            }
        \clist_map_inline:Nn \c_@@_lang_fr_cref_counting_clist
            { \@@_lang_fr_cref_set_counting:nn ##1 }
        \crefformat { equation  } { éq.~##2##1##3  }
        \crefformat { subfigure } { fig.~##2##1##3 }
        \cs_set:Npn \crefpairconjunction        { ~et~ }
        \cs_set:Npn \crefmiddleconjunction      { ,    }
        \cs_set:Npn \creflastconjunction        { ~et~ }
        \cs_set:Npn \crefpairgroupconjunction   { ~et~ }
        \cs_set:Npn \crefmiddlegroupconjunction { ,    }
        \cs_set:Npn \creflastgroupconjunction   { ~et~ }
        \cs_set:Npn \crefrangeconjunction       { ~à~  }
    }
%    \end{macrocode}
% \end{macro}
