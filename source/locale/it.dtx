% \subsubsection{意大利语语言数据}
%
% \begin{macro}{\@@_lang_it_names:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_it_names:
    {
        \cs_set:Npn \prefacename         { Prefazione   }
        \cs_set:Npn \acknowledgmentsname { Ringraziamenti }
        \cs_set:Npn \symabbrname
            { Elenco~dei~simboli~e~delle~abbreviazioni }
        \cs_set:Npn \resumename
            { Curriculum~vitae~e~risultati~accademici }
        \cs_set:Npn \anonymousresumename
            { Risultati~accademici }
        \ctexset
            {
                contentsname   = Indice,
                figurename     = Figura,
                tablename      = Tabella,
                listfigurename = Elenco~delle~figure,
                listtablename  = Elenco~delle~tabelle,
                appendixname   = Appendice,
                bibname        = Bibliografia,
            }
        \DeclareCaptionLabelFormat { @@-it     } { ##1~##2 }
        \DeclareCaptionLabelFormat { @@-it-sub } { (##2)   }
        \captionsetup    { labelformat = @@-it     }
        \subcaptionsetup { labelformat = @@-it-sub }
        \newtagform { @@-it }
            { \mslinespread { 1 } \songti \zihao { 5 } ( }
            { ) }
        \usetagform { @@-it }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_it_mode_two:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_it_mode_two:
    {
        \ctexset
            {
                chapter = {
                    name      = { Capitolo\ , },
                    number    = \arabic { chapter },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 3 }
                        \bfseries
                        \centering
                    },
                },
                section = {
                    name      = { Sezione\ , },
                    number    = \arabic { section },
                    format    = {
                        \mslinespread { 1 }
                        \zihao { 4 }
                        \bfseries
                        \centering
                    },
                },
                subsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}
                    },
                    aftername = \hspace { \ccwd },
                    tocline   = {
                        \CTEXifname
                            {
                                \protect
                                    {
                                        \csname CTEXthe##1 \endcsname
                                        \hspace { \ccwd }
                                    }
                            }
                            { }
                        ##2
                    },
                },
                subsubsection = {
                    indent    = \parindent,
                    number    = {
                        \arabic{chapter}.\arabic{section}.
                        \arabic{subsection}.\arabic{subsubsection}
                    },
                    aftername = \hspace { \ccwd },
                },
            }
    }
%    \end{macrocode}
% \end{macro}
