% \begin{variable}{\c_@@_lang_it_crefname_prop}
%    \begin{macrocode}
\prop_const_from_keyval:Nn \c_@@_lang_it_crefname_prop
    {
        equation      = eq.,
        figure        = figura,
        subfigure     = figura,
        table         = tabella,
        page          = pagina,
        chapter       = capitolo,
        section       = sezione,
        subsection    = sottosezione,
        subsubsection = sottosottosezione,
        appendix      = appendice,
        theorem       = teorema,
        lemma         = lemma,
        corollary     = corollario,
        proposition   = proposizione,
        definition    = definizione,
        example       = esempio,
        algorithm     = algoritmo,
        listing       = Listing,
        line          = riga,
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{variable}{\c_@@_lang_it_cref_counting_clist}
%    \begin{macrocode}
\clist_const:Nn \c_@@_lang_it_cref_counting_clist
    {
        { page          } { pagina          },
        { chapter       } { capitolo        },
        { section       } { sezione         },
        { subsection    } { sottosezione    },
        { subsubsection } { sottosottosezione },
    }
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\@@_lang_it_cref_set_counting:nn}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_it_cref_set_counting:nn
    {
        \crefformat      {#1} { ##2#2~##1##3                     }
        \crefrangeformat {#1} { da~##3#2~##1##4~a~##5#2~##2##6 }
        \crefmultiformat {#1}
            { ##2#2~##1##3   } { e~##2#2~##1##3 }
            { ,~##2#2~##1##3 } { e~##2#2~##1##3 }
        \crefrangemultiformat {#1}
            { da~##3#2~##1##4~a~##5#2~##2##6   }
            { e~da~##3#2~##1##4~a~##5#2~##2##6 }
            { ,~da~##3#2~##1##4~a~##5#2~##2##6 }
            { e~da~##3#2~##1##4~a~##5#2~##2##6 }
        \Crefrangeformat {#1} { Da~##3#2~##1##4~a~##5#2~##2##6 }
        \Crefrangemultiformat {#1}
            { Da~##3#2~##1##4~a~##5#2~##2##6   }
            { e~Da~##3#2~##1##4~a~##5#2~##2##6 }
            { ,~Da~##3#2~##1##4~a~##5#2~##2##6 }
            { e~Da~##3#2~##1##4~a~##5#2~##2##6 }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@@_lang_it_cref:}
%
%    \begin{macrocode}
\cs_new_protected:Nn \@@_lang_it_cref:
    {
        \labelformat { subfigure } { \thefigure~(\thesubfigure) }
        \labelformat { equation  } { (\theequation)             }
        \prop_map_inline:Nn \c_@@_lang_it_crefname_prop
            {
                \crefname {##1} {##2} {##2}
                \Crefname {##1}
                    { \text_titlecase_first:n {##2} }
                    { \text_titlecase_first:n {##2} }
            }
        \clist_map_inline:Nn \c_@@_lang_it_cref_counting_clist
            { \@@_lang_it_cref_set_counting:nn ##1 }
        \crefformat { equation  } { eq.~##2##1##3  }
        \crefformat { subfigure } { fig.~##2##1##3 }
        \cs_set:Npn \crefpairconjunction        { ~e~ }
        \cs_set:Npn \crefmiddleconjunction      { ,   }
        \cs_set:Npn \creflastconjunction        { ~e~ }
        \cs_set:Npn \crefpairgroupconjunction   { ~e~ }
        \cs_set:Npn \crefmiddlegroupconjunction { ,   }
        \cs_set:Npn \creflastgroupconjunction   { ~e~ }
        \cs_set:Npn \crefrangeconjunction       { ~a~ }
        \cs_set:Npn \crefrangepreconjunction    { da~ }
    }
%    \end{macrocode}
% \end{macro}
